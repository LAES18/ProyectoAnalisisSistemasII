NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Configure MYSQL_URL or the individual DB_* variables below.
MYSQL_URL=mysql://usuario:password@host:3306/base_de_datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_academico
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

SEED_DEMO=true
